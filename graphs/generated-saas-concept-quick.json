{
  "name": "SaaS / 软件 — 概念版 — 快速摸底",
  "description": "品类: SaaS / 软件 | 维度: 概念版 | 模式: 快速摸底 | 节点: 4, 边: 3",
  "nodes": [
    {
      "id": "market",
      "name": "1. 市场调研",
      "type": "skill",
      "skill_name": "market-research",
      "config": {
        "duration_seconds": 3,
        "human_collab": "pause"
      }
    },
    {
      "id": "competitive",
      "name": "2. 竞品分析",
      "type": "skill",
      "skill_name": "competitive-analysis",
      "config": {
        "duration_seconds": 4,
        "human_collab": "auto"
      }
    },
    {
      "id": "gate_quick",
      "name": "门禁 - 快速摸底审核",
      "type": "gate",
      "skill_name": "",
      "config": {
        "max_retries": 2,
        "rules": [
          {
            "type": "file_exists",
            "path": "${node.market.output_dir}/market.md"
          },
          {
            "type": "file_exists",
            "path": "${node.competitive.output_dir}/competitive.md"
          },
          {
            "type": "file_min_size",
            "path": "${node.market.output_dir}/market.json",
            "min_bytes": 10
          },
          {
            "type": "file_min_size",
            "path": "${node.competitive.output_dir}/competitive.json",
            "min_bytes": 10
          },
          {
            "type": "json_field_present",
            "path": "${node.market.output_dir}/market.json",
            "field": "status"
          },
          {
            "type": "json_field_present",
            "path": "${node.competitive.output_dir}/competitive.json",
            "field": "status"
          }
        ]
      }
    },
    {
      "id": "summary",
      "name": "简报汇总",
      "type": "skill",
      "skill_name": "mock-summary",
      "config": {
        "duration_seconds": 2,
        "human_collab": "flag",
        "flag_timeout": 10
      }
    }
  ],
  "edges": [
    {
      "from": "market",
      "to": "gate_quick"
    },
    {
      "from": "competitive",
      "to": "gate_quick"
    },
    {
      "from": "gate_quick",
      "to": "summary"
    }
  ]
}